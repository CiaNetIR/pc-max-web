# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-ghpages/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases (recreate with `bun run db:push` + `bun prisma/seed.ts`)
/db/

# logs
*.log
dev.log
dev.out.log
server.log

# local editor / agent scratch
local-*
.claude
.z-ai-config
prompt
agent-ctx

# ── sandbox / platform internals (not part of the website) ──────────────────
/skills/
/examples/
/tests/
/mini-services/
/tool-results/
/upload/
/download/
/.zscripts/
/worklog.md
Caddyfile
